{
  "name": "clear-pricer-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server over clear-pricer's public hospital price and provider data release, with provenance on every row.",
  "license": "MIT",
  "author": "Trevor J. Romack <tjromack@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjromack/clear-pricer-mcp.git"
  },
  "type": "module",
  "bin": {
    "clear-pricer-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project offline",
    "test:release": "vitest run --project release",
    "start": "node dist/index.js",
    "fixtures": "node --import tsx scripts/make-fixtures.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "mutate": "node --import tsx scripts/mutate.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "healthcare",
    "price-transparency",
    "nppes",
    "duckdb"
  ],
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "env-paths": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "homepage": "https://github.com/tjromack/clear-pricer-mcp#readme",
  "bugs": {
    "url": "https://github.com/tjromack/clear-pricer-mcp/issues"
  }
}
